# URL pública del sitio (usada en robots.txt y sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://programa29n.app

# Buzón ciudadano (/api/contact) — canales opcionales de entrega.
# Sin configurar ninguno, el formulario valida la petición pero no abre incidencias externas.

# Opción 1: crear un issue en GitHub automáticamente
GITHUB_CONTACT_TOKEN=
GITHUB_CONTACT_REPO=javirodel/Programas29N

# Opción 2: webhook HTTPS (Discord, Slack, n8n, etc.)
CONTACT_WEBHOOK_URL=

# Opción 3: envío por correo mediante Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL=Programa29N <onboarding@resend.dev>
