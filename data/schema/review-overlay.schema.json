{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "party_id": {
      "type": "string",
      "enum": [
        "adelante-andalucia",
        "bng",
        "coalicion-canaria",
        "compromis",
        "erc",
        "falange",
        "frente-obrero",
        "iustitia-europa",
        "pacma",
        "partido-humanista",
        "pnv",
        "por-un-mundo-mas-justo",
        "pp",
        "psoe",
        "salf",
        "soria-ya",
        "teruel-existe",
        "vox"
      ]
    },
    "entries": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "propuesta",
              "reservada"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "extraida",
              "requiere_revision",
              "verificada",
              "corregida",
              "rechazada"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "official_text": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string",
                "minLength": 2
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          },
          "original_section": {
            "type": "string",
            "minLength": 1
          },
          "official_number": {
            "type": "string",
            "minLength": 1
          },
          "theme_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pages": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "snippet": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                "docling_refs": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "pages",
                "snippet",
                "docling_refs"
              ],
              "additionalProperties": false
            }
          },
          "clear_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "status",
          "reviewer",
          "date",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "party_id",
    "entries"
  ],
  "additionalProperties": false
}
