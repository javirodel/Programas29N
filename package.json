{
  "name": "29n-programas-electorales",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma cívica neutral y verificable de consulta, comparación y afinidad sobre los programas electorales del 29N.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run data:build",
    "build": "next build",
    "start": "next start",
    "data:build": "node tools/data/build-corpus.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tools/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tools/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,mjs,json}\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "minisearch": "^7.2.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss": "^8.5.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
